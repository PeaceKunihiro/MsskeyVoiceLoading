{
  "manifest_version": 3,
  "name": "Misskey Reader",
  "description": "Misskeyの新着ノート本文をVOICEVOXで読み上げます。",
  "version": "0.2.0",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "http://localhost:50021/*",
    "http://127.0.0.1:50021/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://misskey.niri.la/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Misskey Reader 設定"
  }
}
